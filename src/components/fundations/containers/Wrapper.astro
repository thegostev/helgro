---
interface Props {
  variant?: "standard" | "paddingless" | "wide" | "narrow" | "prose"; // Define any variants you need
  class?: string; // Optional prop for additional classes
}
const { variant = "standard", class: extraClass = "" } = Astro.props;
// Map each variant to its specific classes
const variantClasses = {
  // All purpose wrapper
  wide: "max-w-screen mx-auto px-4 w-full 2xl:max-w-[180rem]",
  narrow: "max-w-xl px-4 w-full",
  standard: " max-w-screen mx-auto px-8 w-full 2xl:max-w-[180rem]",
  paddingless: "max-w-screen mx-auto w-full 2xl:max-w-[180rem]",
  // Wrapper for prose blocks
  prose:
    "prose prose-lg text-base-800 prose-p:text-base-800 prose-li:text-base-800 prose-a:border-base-200 prose-a:border-b prose-a:no-underline prose-a:text-base-950 prose-a:duration-200 prose-a:hover:text-base-600 prose-headings:font-medium prose-headings:text-base-950 prose-li:marker:text-base-600 max-w-none w-full prose-tr:border-base-200 prose-thead:border-base-200 prose-strong:text-base-950 prose-blockquote:not-italic prose-blockquote:font-normal prose-blockquote:text-base-950 prose-blockquote:text-2xl prose-blockquote:leading-[1.4] prose-blockquote:tracking-[-0.01em] prose-blockquote:border-l-[3px] prose-blockquote:border-base-950 prose-blockquote:pl-[26px] prose-blockquote:my-[34px] [&_blockquote_p:first-of-type]:before:content-none [&_blockquote_p:last-of-type]:after:content-none [&_blockquote_p:last-of-type:not(:only-child)]:text-sm [&_blockquote_p:last-of-type:not(:only-child)]:text-base-600 [&_blockquote_p:last-of-type:not(:only-child)]:mt-3 [&_blockquote_cite]:block [&_blockquote_cite]:not-italic [&_blockquote_cite]:text-sm [&_blockquote_cite]:text-base-600 [&_blockquote_cite]:mt-3",
};
// Combine the classes for the specified variant with any extra classes
const classes = `${variantClasses[variant]} ${extraClass}`.trim();
---

<div class={classes}>
  <slot />
</div>
